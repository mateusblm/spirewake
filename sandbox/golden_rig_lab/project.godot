; Engine configuration file.
; Spirewake — Golden Rig Lab (P2.4B-0). Isolated visual sandbox. No gameplay code.

config_version=5

[application]

config/name="Spirewake Golden Rig Lab"
config/description="Isolated visual test bench for the VANGUARD_SWORD_SHIELD shared rig (P1.5 frozen manifest). No gameplay logic."
run/main_scene="res://scenes/golden_rig_lab.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1440
window/size/viewport_height=960

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
